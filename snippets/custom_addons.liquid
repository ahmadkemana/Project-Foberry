<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css" />

<!-- Swiper JS -->
<script src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js"></script>
{{ 'custom_addons.css' | asset_url | stylesheet_tag }}
<div class="main-custom-addons">
  
{% if product_data.options != blank %}
<div class="custom_addons">
  <div class="inner_addons">
  {% comment %}
    {% endcomment %}
  <div class="product-orignal-price hidden" data-price-value="{{ product.price }}">{{ product.price | money }}</div>
    
  <div class="addons_heading"><span class="icon-img"><img src="https://cdn.shopify.com/s/files/1/0733/9101/4200/files/Gemini_Generated_Image_29vhm829vhm829vh.png?v=1776535918" > </span> <p>Customizations</p><span>(Optional)</span></div>
    {%  for option in product_data.options %}
      <details class="addon_wrap">
        <summary class="addon_label_txt">
            <span>{{ option.label }}</span>
          <span class="inner_addon_label_txt"></span>
          <span class="summary_icon"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 640 640"><!--!Font Awesome Free v7.0.0 by @fontawesome - https://fontawesome.com License - https://fontawesome.com/license/free Copyright 2025 Fonticons, Inc.--><path d="M297.4 438.6C309.9 451.1 330.2 451.1 342.7 438.6L502.7 278.6C515.2 266.1 515.2 245.8 502.7 233.3C490.2 220.8 469.9 220.8 457.4 233.3L320 370.7L182.6 233.4C170.1 220.9 149.8 220.9 137.3 233.4C124.8 245.9 124.8 266.2 137.3 278.7L297.3 438.7z"/></svg></span>
        </summary>
        <div class="addon_info_wrap">
            {% for value in option.values %}
              <div class="values_wrap">
                <input class="addon_value" name="properties[{{ option.title }}]" data-price="{{ value.price }}" more-charges="{{ value.price }}"  value="{{ value.value }}" type="radio" id="{{ option.label }}-{{ forloop.index }}-{{ value.id }}">
                <label data-label={{ value.value }} data-price="{{ value.price }}" class="addon_label"  {% if value.feature_image != blank %} border_extra{% endif %}" for="{{ option.label }}-{{ forloop.index }}-{{ value.id }}">
                  {% if value.feature_image != blank %}
                    <img class="addon_img" src="{{ value.feature_image | image_url: 'master' }}" alt="{{ option.label }}">
                  {% endif %}
                    <span >
                    {{ value.value }}
                    </span>
                </label>
              </div>
            {% endfor %}
          {% if option.instructions != blank %}
            <div class="note_addon">
              {{ option.instructions }}
            </div>
          {% endif %}
        </div>
      </details>
    {% endfor %}
    {% assign enable_monogram = product_data.enable_monogram %}
    {% if enable_monogram == '1' or enable_monogram == 1 %} 
  <div class="mono_heading">
<p>Monogram/Initials</p>
  </div>
    {% assign monogramdata = product_data.monogram %}
    
      
      <details class="addon_wrap_mono addons-monogram-close">
        <summary class="addon_label_mono">
            <span>Monogram +RS {{ monogramdata.setting.additional_cost }}</span>
          
    
        </summary>
      
      </details>
    {% endif %}
  <span class="inner_addon_label_txt addons_mono_select"></span>
   <div class="addons-remove-monogram hidden"> Remove Monogram </div>
  </div>

</div>
  
{% endif %}
{% if product_data.extras != blank %}
<div class="extras_wrap">
  <div class="extras_inner">
    <span class="extras_heading">
        Extras (optional)
    </span>
      <!-- Slider main container -->
        <div class="mySwiper">
          <!-- Additional required wrapper -->
          <div class="swiper-wrapper">
            {% for slide in product_data.extras %}
              <div class="swiper-slide">
                  <div class="slider_img_wrap">
                    <a class="img_link" href="#">
                      <img class="slide-img" src="{{ slide.feature_image }}" alt="{{ slide.title }}">
                    </a>
                  </div>
                  <div class="slide_dets">
                      <h2 class="slide_title">
                          {{ slide.title }}
                      </h2>
                      <p class="slide_price">
                      RS {{ slide.price }}
                      </p>
                      <label>
                          <input class="add_to_order" more-charges="{{ slide.price }}" type="checkbox" name="properties[{{ slide.title }}]" value="{{ slide.title }}">
                          <span>Add To Bag</span>
                      </label>
                  </div>
              </div>
            {% endfor %}
          </div>
          
          <div class="swiper_arrows">
            <div class="swiper_btns swiper-button-prev"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 640 640"><!--!Font Awesome Free v7.0.0 by @fontawesome - https://fontawesome.com License - https://fontawesome.com/license/free Copyright 2025 Fonticons, Inc.--><path fill="#ffffff" d="M439.1 297.4C451.6 309.9 451.6 330.2 439.1 342.7L279.1 502.7C266.6 515.2 246.3 515.2 233.8 502.7C221.3 490.2 221.3 469.9 233.8 457.4L371.2 320L233.9 182.6C221.4 170.1 221.4 149.8 233.9 137.3C246.4 124.8 266.7 124.8 279.2 137.3L439.2 297.3z"/></svg></div>
            <div class="swiper_btns swiper-button-next"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 640 640"><!--!Font Awesome Free v7.0.0 by @fontawesome - https://fontawesome.com License - https://fontawesome.com/license/free Copyright 2025 Fonticons, Inc.--><path fill="#ffffff" d="M439.1 297.4C451.6 309.9 451.6 330.2 439.1 342.7L279.1 502.7C266.6 515.2 246.3 515.2 233.8 502.7C221.3 490.2 221.3 469.9 233.8 457.4L371.2 320L233.9 182.6C221.4 170.1 221.4 149.8 233.9 137.3C246.4 124.8 266.7 124.8 279.2 137.3L439.2 297.3z"/></svg></div>
          </div>
        </div>
  </div>
</div>
{% endif %}
<div class="additional_charges">
<input type="" hidden class="addons-additional-price"  name="properties[additional_price]" value="0" >
</div>

</div>


<div class="addon_info_wrap addons-monogram hidden">
 {% render 'customizer_addons_mono',position_type:product_data.position_type , monogram:product_data.monogram %}
  </div>  

{% comment %} <script src="{{ 'custom_addons.js' | asset_url }}" defer="defer"></script> {% endcomment %}
{% comment %} <script src="{{ 'option-card.js' | asset_url }}" defer="defer"></script> {% endcomment %}
{% comment %} <script src="{{ 'custom-add-to-cart.js' | asset_url }}" defer="defer"></script>  {% endcomment %}